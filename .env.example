# Copy to .env or .env.local and adjust. .env.local is gitignored and wins over .env.
#
# --- Recommended for real E2E (category create/update/delete on DEV API) ---
# TARGET=dev
# BASE_URL=https://admin.ntmt.dev.gulftmt.com
# API_BASE_URL=https://api.ntmt.dev.gulftmt.com
# VALID_USERNAME=Soham06
# VALID_PASSWORD=<your-dev-admin-password>
#
# --- Local UI on :8000 + local UMS (:8082) — ADMIN/Test@123 ---
# TARGET=local
# BASE_URL=http://localhost:8000

TARGET=dev

# Explicit URLs override TARGET presets when set:
# BASE_URL=http://localhost:8000
# API_BASE_URL=https://api.ntmt.dev.gulftmt.com

# Admin credentials (required — local ADMIN does not work on TARGET=dev)
# VALID_USERNAME=Soham06
# VALID_PASSWORD=your-dev-password

# Backend root (for docs / helper scripts only)
# BACKEND_DIR=../../gulfnet-tmt-backend
