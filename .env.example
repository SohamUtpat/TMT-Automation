# Copy to .env or .env.local and adjust. .env.local is gitignored and wins over .env.
#
# TARGET=local  → http://localhost:8000 + gateway :9091
# TARGET=dev    → remote admin.ntmt.dev (default)
TARGET=dev

# Explicit URLs override TARGET presets when set:
# BASE_URL=http://localhost:8000
# API_BASE_URL=http://localhost:9091

# Admin credentials (defaults exist in Admin/data/loginData.ts)
# VALID_USERNAME=ADMIN
# VALID_PASSWORD=your-password

# Optional: start webpack frontend before tests (requires FRONTEND_DIR)
# START_FRONTEND=1
# FRONTEND_DIR=../gulfnet-tmt-frontend

# Backend root (for docs / helper scripts only — Playwright does not start Java services)
# BACKEND_DIR=../../gulfnet-tmt-backend
