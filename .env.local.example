# Copy this file to .env.local for local stack runs:
#   copy .env.local.example .env.local
#
# Prerequisites:
# 1. Backend gateway on :9091 and user-management on :8082
#    (from gulfnet-tmt-backend: api-gateway-service + user-management-service)
# 2. Frontend .env BACKEND_BASE_URL=http://localhost:9091/api/user-management-service/
# 3. Frontend running on :8000 (or set START_FRONTEND=1 below)

TARGET=local
BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:9091

# VALID_USERNAME=ADMIN
# VALID_PASSWORD=your-local-password

# Uncomment to let Playwright start the React app if it is not already up:
# START_FRONTEND=1
# FRONTEND_DIR=../gulfnet-tmt-frontend
