{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "GulfTMT Admin Portal - Playwright automation",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env TARGET=dev playwright test",
    "test:local": "cross-env TARGET=local playwright test",
    "test:local:headed": "cross-env TARGET=local playwright test --headed",
    "test:local:ui": "cross-env TARGET=local playwright test --ui",
    "test:local:with-frontend": "cross-env TARGET=local START_FRONTEND=1 playwright test",
    "test:login": "playwright test Admin/Login",
    "test:login:local": "cross-env TARGET=local playwright test Admin/Login",
    "test:dashboard": "playwright test Admin/DashBoard",
    "test:dashboard:local": "cross-env TARGET=local playwright test Admin/DashBoard",
    "test:groups": "playwright test Admin/Groups",
    "test:groups:local": "cross-env TARGET=local playwright test Admin/Groups",
    "test:mobile-users": "playwright test Admin/MobileUsers",
    "test:mobile-users:local": "cross-env TARGET=local playwright test Admin/MobileUsers",
    "test:mobile-users:first10": "playwright test Admin/MobileUsers/TC-157.spec.ts Admin/MobileUsers/TC-158.spec.ts Admin/MobileUsers/TC-159.spec.ts Admin/MobileUsers/TC-160.spec.ts Admin/MobileUsers/TC-161.spec.ts Admin/MobileUsers/TC-162.spec.ts Admin/MobileUsers/TC-163.spec.ts Admin/MobileUsers/TC-164.spec.ts Admin/MobileUsers/TC-165.spec.ts Admin/MobileUsers/TC-166.spec.ts",
    "test:admin-users": "playwright test Admin/AdminUsers",
    "test:admin-users:local": "cross-env TARGET=local playwright test Admin/AdminUsers",
    "test:admin-users:first10": "playwright test Admin/AdminUsers/TC-241.spec.ts Admin/AdminUsers/TC-246.spec.ts Admin/AdminUsers/TC-247.spec.ts Admin/AdminUsers/TC-264.spec.ts Admin/AdminUsers/TC-265.spec.ts Admin/AdminUsers/TC-222.spec.ts Admin/AdminUsers/TC-225.spec.ts Admin/AdminUsers/TC-224.spec.ts Admin/AdminUsers/TC-252.spec.ts Admin/AdminUsers/TC-253.spec.ts",
    "test:change-password": "playwright test Admin/ChangePassword",
    "test:change-password:local": "cross-env TARGET=local playwright test Admin/ChangePassword",
    "test:change-language": "playwright test Admin/ChangeLanguage",
    "test:change-language:local": "cross-env TARGET=local playwright test Admin/ChangeLanguage",
    "test:forms": "playwright test Admin/Forms",
    "test:forms:local": "cross-env TARGET=local playwright test Admin/Forms",
    "test:settings": "playwright test Admin/Settings",
    "test:settings:local": "cross-env TARGET=local playwright test Admin/Settings",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "env:local": "node scripts/ensure-local-env.cjs",
    "check:local": "cross-env TARGET=local node scripts/check-local.cjs",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "xlsx": "^0.18.5"
  }
}
